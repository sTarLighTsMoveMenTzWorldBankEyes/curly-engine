6. API Gateway for Multi-Org Access
TypeScript
// GitHub Copilot API Gateway (TypeScript)

import { FastifyInstance } from "fastify";
import { GitHubAPI } from "@octokit/rest";
import { OktaOIDC } from "@okta/okta-sdk-nodejs";

export class MultiAccessGateway {
  constructor(
    private github: GitHubAPI,
    private okta: OktaOIDC,
    private vault: VaultClient
  ) {}

  // Federated token exchange
  async authenticateUser(code: string): Promise<AuthToken> {
    const idToken = await this.okta.exchangeCodeForTokens(code);
    const user = await this.okta.getUser(idToken.claims.sub);
    
    // Get GitHub token from vault
    const githubToken = await this.vault.read(
      `github/tokens/${user.email}`
    );

    // Create session token with multi-org scope
    return {
      sessionToken: this.createSessionToken(user),
      githubToken,
      organizations: await this.getUserOrganizations(user.email),
      roles: await this.getUserRoles(user.email),
      permissions: await this.calculatePermissions(user.email),
    };
  }

  // Cross-org query
  async queryAcrossOrgs(
    query: string,
    orgs?: string[]
  ): Promise<QueryResult[]> {
    const targetOrgs = orgs || (await this.getAllAccessibleOrgs());
    
    return Promise.all(
      targetOrgs.map(org =>
        this.github.graphql(query, { org })
      )
    );
  }

  // RBAC enforcement
  async enforceRBAC(
    userId: string,
    action: string,
    org: string
  ): Promise<boolean> {
    const permissions = await this.getUserPermissions(userId, org);
    return permissions.includes(action);
  }

  // Approval workflow
  async requestApproval(
    action: string,
    org: string,
    userId: string
  ): Promise<ApprovalRequest> {
    const requiredApprovers = await this.getRequiredApprovers(action, org);
    
    return {
      id: generateID(),
      action,
      org,
      requestedBy: userId,
      requiredApprovers,
      createdAt: new Date(),
      expiresAt: new Date(Date.now() + 4 * 60 * 60 * 1000), // 4 hours
    };
  }
}
