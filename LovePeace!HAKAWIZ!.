// Temporal Workflow for Cross-Org Operations

import * as wf from "@temporalio/workflow";
import * as activities from "./activities";

export async function crossOrgSecurityAudit(
  organizations: string[]
): Promise<AuditResult> {
  
  // Scan vulnerabilities in parallel across all orgs
  const scanResults = await wf.all(
    organizations.map(org =>
      wf.executeActivity(activities.scanVulnerabilities, {
        org,
        scanType: "dependency-check",
      })
    )
  );

  // Check compliance after scans complete
  const complianceResults = await wf.all(
    organizations.map((org, idx) =>
      wf.executeActivity(activities.checkCompliance, {
        org,
        scanResult: scanResults[idx],
      })
    )
  );

  // Generate unified report
  const report = await wf.executeActivity(
    activities.generateAuditReport,
    {
      scans: scanResults,
      compliance: complianceResults,
    }
  );

  // Create issues for findings
  const issues = await wf.all(
    organizations.map((org, idx) =>
      wf.executeActivity(activities.createIssue, {
        org,
        title: `Security Audit Results - ${new Date().toISOString()}`,
        report: report,
      })
    )
  );

  return {
    auditId: generateID(),
    timestamp: new Date(),
    organizations,
    scanResults,
    complianceResults,
    report,
    issues,
  };
}
