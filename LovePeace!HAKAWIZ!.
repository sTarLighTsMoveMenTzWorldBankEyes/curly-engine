# ~/.copilot-multi/config.yaml
version: 2
identity_provider:
  type: okta
  domain: mycompany.okta.com
  client_id: ${OKTA_CLIENT_ID}
  client_secret: ${OKTA_CLIENT_SECRET}
  scopes:
    - openid
    - profile
    - email
    - groups

organizations:
  company-main:
    id: org-1
    github_handle: company-main
    access: admin
    environments:
      - production
      - staging
      - development
    settings:
      require_2fa: true
      enforce_sso: true
      audit_logging: true

  company-platform:
    id: org-2
    github_handle: company-platform
    access: maintainer
    environments:
      - production
      - staging
    settings:
      require_2fa: true
      enforce_sso: true

  company-security:
    id: org-3
    github_handle: company-security
    access: maintainer
    environments:
      - production
    settings:
      require_2fa: true
      enforce_sso: true
      additional_approvers: 2

rbac:
  roles:
    admin:
      permissions:
        - "orgs:manage"
        - "orgs:audit"
        - "rbac:manage"
        - "users:manage"
        - "secrets:manage"
        - "deployments:manage"
      orgs: "*"  # All orgs
    
    devops:
      permissions:
        - "deployments:manage"
        - "infrastructure:manage"
        - "secrets:read"
        - "monitoring:read"
      orgs:
        - "company-platform"
        - "company-main"
    
    developer:
      permissions:
        - "repos:read"
        - "repos:write"
        - "prs:create"
        - "prs:review"
        - "issues:manage"
      orgs:
        - "company-main"
        - "open-source-org"
    
    security_officer:
      permissions:
        - "audit:read"
        - "compliance:read"
        - "vulnerabilities:manage"
        - "secrets:audit"
      orgs: "*"
    
    auditor:
      permissions:
        - "orgs:read"
        - "repos:read"
        - "audit:read"
        - "compliance:read"
      orgs: "*"

access_rules:
  - name: "Require approval for prod deployments"
    trigger: "deployment:production"
    condition: "org == company-main"
    action: "require_approval"
    approvers_count: 2
    approver_roles:
      - devops
      - admin
  
  - name: "Audit security org changes"
    trigger: "org:change"
    condition: "org == company-security"
    action: "log_to_audit"
    notify: ["security-team"]
  
  - name: "Enforce MFA for sensitive actions"
    trigger: "action:sensitive"
    condition: "true"
    action: "require_mfa"
    actions:
      - "secrets:write"
      - "rbac:change"
      - "users:remove"

token_management:
  strategy: rotation
  rotation_interval: 24h
  backup_tokens: 2
  secure_storage: vault
  vault_path: secret/github/tokens

audit_logging:
  enabled: true
  destination: cloudwatch
  retention: 90d
  events:
    - user:login
    - org:change
    - rbac:change
    - deployment:execute
    - secrets:access
    - audit:query
B. Workflow Orchestration
YAML
# workflows/cross-org-security-audit.yaml
version: 1
name: "Cross-Org Security Audit"
description: "Weekly security audit across all orgs"

triggers:
  - type: schedule
    cron: "0 2 * * 0"  # Weekly, Sunday 2 AM

tasks:
  - id: scan-vulnerabilities
    type: security-scan
    parallel: true
    for_each: "organizations"
    config:
      scan_type: "dependency-check"
      fail_on: "critical"
    notify:
      - channel: slack
        message: "🔒 Vulnerability scan completed for {{ org }}"
  
  - id: check-compliance
    type: compliance-check
    depends_on: scan-vulnerabilities
    parallel: true
    for_each: "organizations"
    config:
      checks:
        - require_branch_protection
        - require_2fa
        - enforce_sso
        - audit_logging_enabled
    notify_on_failure: true
  
  - id: generate-report
    type: report-generation
    depends_on: check-compliance
    config:
      format: pdf
      include:
        - summary
        - vulnerabilities
        - compliance_status
        - recommendations
      send_to:
        - email: security-team@company.com
        - slack: #security-reports

  - id: create-issues
    type: github-action
    depends_on: generate-report
    parallel: true
    for_each: "organizations"
    config:
      action: create-issue
      title: "Security Audit Results - {{ date }}"
      body: |
        ## Security Audit Report
        
        **Organization**: {{ org }}
        **Date**: {{ date }}
        **Status**: {{ compliance_status }}
        
        ### Vulnerabilities Found
        {{ vulnerabilities_summary }}
        
        ### Compliance Issues
        {{ compliance_issues }}
        
        ### Recommendations
        {{ recommendations }}
      repo: "company-org/security-reports"
      labels:
        - "security"
        - "audit"
