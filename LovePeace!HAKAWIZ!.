      @OnTamperDetected()
      async function selfDestruct() {
        // 1. Immediately invalidate all sessions
        await this.revokeAllSessions();
        // 2. Delete all local keys
        await this.deleteEncryptionKeys();
        // 3. Alert security team
        await this.alertSOC("Code tampering detected");
        // 4. Crash process (clean shutdown)
        process.exit(1);
      }
    }
    
    return sessionToken;
  }
