4. GitHub Actions Workflow (Auto-Deploy)
YAML
# .github/workflows/deploy-wildcard.yml
name: Deploy with Wildcard Domain

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

env:
  REGISTRY: ghcr.io
  TAILSCALE_AUTH_KEY: ${{ secrets.TAILSCALE_AUTH_KEY }}
  CADDY_LICENSE: ${{ secrets.CADDY_LICENSE }}

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      # 1. Checkout code
      - name: Checkout repository
        uses: actions/checkout@v4
      
      # 2. Set up Docker Buildx
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      # 3. Login to GitHub Container Registry
      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      
      # 4. Extract branch name and create subdomain
      - name: Create dynamic subdomain
        id: subdomain
        run: |
          BRANCH=$(echo ${{ github.ref }} | sed 's|refs/heads/||')
          SUBDOMAIN=$(echo $BRANCH | sed 's/[^a-zA-Z0-9]/-/g' | tr '[:upper:]' '[:lower:]')
          DEPLOYMENT_URL="${SUBDOMAIN}.1.2.3.4.nip.io"
          echo "subdomain=${SUBDOMAIN}" >> $GITHUB_OUTPUT
          echo "deployment_url=${DEPLOYMENT_URL}" >> $GITHUB_OUTPUT
          echo "✅ Deployment URL: $DEPLOYMENT_URL"
      
      # 5. Build and push Docker images
      - name: Build and push API image
        uses: docker/build-push-action@v5
        with:
          context: ./api
          push: true
          tags: ${{ env.REGISTRY }}/${{ github.repository }}/api:${{ steps.subdomain.outputs.subdomain }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      
      - name: Build and push Web image
        uses: docker/build-push-action@v5
        with:
          context: ./web
          push: true
          tags: ${{ env.REGISTRY }}/${{ github.repository }}/web:${{ steps.subdomain.outputs.subdomain }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      
      # 6. Deploy to VPS via SSH
      - name: Deploy via SSH
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
          key: ${{ secrets.VPS_SSH_KEY }}
          script: |
            cd /opt/deployments
            
            # Create deployment directory
            mkdir -p ${{ steps.subdomain.outputs.subdomain }}
            cd ${{ steps.subdomain.outputs.subdomain }}
            
            # Update docker-compose.yml with new images
            cat > docker-compose.yml << 'EOF'
            version: '3.9'
            services:
              api:
                image: ${{ env.REGISTRY }}/${{ github.repository }}/api:${{ steps.subdomain.outputs.subdomain }}
                ports:
                  - "${{ secrets.API_PORT }}:3000"
              web:
                image: ${{ env.REGISTRY }}/${{ github.repository }}/web:${{ steps.subdomain.outputs.subdomain }}
                ports:
                  - "${{ secrets.WEB_PORT }}:8080"
            EOF
            
            # Deploy
            docker-compose pull
            docker-compose up -d
            
            # Update Caddy config
            curl -X POST http://localhost:2019/load \
              -H "Content-Type: text/caddyfile" \
              -d "@Caddyfile"
      
      # 7. Run health checks
      - name: Health check
        run: |
          DEPLOYMENT_URL=${{ steps.subdomain.outputs.deployment_url }}
          echo "🏥 Checking deployment health..."
          for i in {1..30}; do
            if curl -k --fail https://$DEPLOYMENT_URL/health 2>/dev/null; then
              echo "✅ Deployment healthy!"
              exit 0
            fi
            echo "⏳ Waiting... ($i/30)"
            sleep 5
          done
          echo "❌ Health check failed"
          exit 1
      
      # 8. Create deployment comment on PR
      - name: Comment on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `🚀 **Deployment Successful!**\n\n📍 **Live URL**: https://${{ steps.subdomain.outputs.deployment_url }}\n\n🔒 **SSL/HTTPS**: ✅ Auto-provisioned\n🌐 **VPN**: ✅ Tailscale Protected\n🔄 **Auto-proxy**: ✅ Caddy Configured`
            })
